{
    "name": "andaris/resque-webui-bundle",
    "description": "Web interface for php-resque",
    "license": "BSD-3-Clause",
    "type": "symfony-bundle",
    "authors": [
        {
            "name": "Andreas Erhard",
            "email": "developer@andaris.at"
        },
        {
            "name": "Sarah Bernardi",
            "email": "s.bernardi@mci4me.at"
        },
        {
            "name": "Luisa Brinkschulte",
            "email": "l.brinkschulte@mci4me.at"
        },
        {
            "name": "Claudia Postulka",
            "email": "c.postulka@mci4me.at"
        }
    ],
    "support": {
        "issues": "https://github.com/xelan/resque-webui-bundle/issues",
        "source": "https://github.com/xelan/resque-webui-bundle/"
    },
    "autoload": {
        "psr-4": {
            "Andaris\\ResqueWebUiBundle\\": ""
        },
        "files": [
            "php-resque-compatibility.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Andaris\\ResqueWebUiBundle\\Tests\\": "Tests"
        }
    },
    "require": {
        "php": ">=7.2.5",
        "mjphaynes/php-resque": "^2.1|^3.0|^4.0",
        "symfony/http-foundation": "^3.4|^4.4|^5.4",
        "symfony/http-kernel": "^3.4|^4.4|^5.4",
        "twig/twig": "^1.44|^2.16|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5.52",
        "squizlabs/php_codesniffer": "^4.0.4",
        "symfony/config": "^3.4|^4.4|^5.4",
        "symfony/dependency-injection": "^3.4|^4.4|^5.4",
        "symfony/yaml": "^3.4|^4.4|^5.4"
    },
    "config": {
        "bin-dir": "bin"
    }
}
