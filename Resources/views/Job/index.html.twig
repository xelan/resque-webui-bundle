{% set page = {
    title: 'Jobs',
    description: 'Resque WebUI jobs'
} %}

{% extends '@AndarisResqueWebUi/layout.html.twig' %}

{% block content %}
    {% import '@AndarisResqueWebUi/macros.html.twig' as helper %}

    {# a filter keeps the ordering, the ordering keeps every filter, and each
       filter keeps the other one so that only what is clicked on changes #}
    {% set order = {'sort': criteria.field, 'direction': criteria.direction} %}
    {% set filter = criteria.filterParameters %}
    {% set byStatus = order|merge(criteria.queueParameters) %}
    {% set byQueue = order|merge(criteria.statusParameters) %}

    <div class="col-lg-12">
        <h1>Jobs</h1>

        <ul class="nav nav-pills job-status-filter">
            <li class="{{ criteria.status is null ? 'active' }}">
                <a href="{{ path('andaris_resque_web_ui_jobs', byStatus) }}">
                    All <span class="badge">{{ total }}</span>
                </a>
            </li>
            {% for status, count in counts %}
            <li class="{{ criteria.status == status ? 'active' }}">
                <a href="{{ path('andaris_resque_web_ui_jobs', byStatus|merge({'status': status})) }}">
                    {{ status | formatJobStatus }} <span class="badge">{{ count }}</span>
                </a>
            </li>
            {% endfor %}
        </ul>

        {% if criteria.queue is not null %}
        <p class="job-queue-filter">
            Showing the jobs on the queue <strong>{{ criteria.queue }}</strong>.
            <a href="{{ path('andaris_resque_web_ui_jobs', byQueue) }}">Show every queue</a>
        </p>
        {% endif %}

        <table class="table table-striped table-responsive">
            <tr>
                {{ helper.sortableHeader('ID', 'id', criteria, 'andaris_resque_web_ui_jobs', filter) }}
                {{ helper.sortableHeader('Status', 'status', criteria, 'andaris_resque_web_ui_jobs', filter) }}
                {{ helper.sortableHeader('Queue', 'queue', criteria, 'andaris_resque_web_ui_jobs', filter) }}
                {{ helper.sortableHeader('Worker', 'worker', criteria, 'andaris_resque_web_ui_jobs', filter) }}
                {{ helper.sortableHeader('Created', 'created', criteria, 'andaris_resque_web_ui_jobs', filter) }}
                {{ helper.sortableHeader('Started', 'started', criteria, 'andaris_resque_web_ui_jobs', filter) }}
                {{ helper.sortableHeader('Updated', 'updated', criteria, 'andaris_resque_web_ui_jobs', filter) }}
                {{ helper.sortableHeader('Finished', 'finished', criteria, 'andaris_resque_web_ui_jobs', filter) }}
            </tr>
            {% for job in jobs %}
            <tr>
                <td class="job-id"><a href="{{ path('andaris_resque_web_ui_job', {'jobId': job.id}) }}">{{ job.id }}</a></td>
                <td>{{ job.status | formatJobStatus }}</td>
                <td><a href="{{ path('andaris_resque_web_ui_jobs', byQueue|merge({'queue': job.queue})) }}">{{ job.queue }}</a></td>
                <td>{{ job.worker }}</td>
                <td class="date-time">{{ job.created | formatTime }}</td>
                <td class="date-time">{{ job.started | formatTime }}</td>
                <td class="date-time">{{ job.updated | formatTime }}</td>
                <td class="date-time">{{ job.finished | formatTime }}</td>
            </tr>
            {% else %}
            <tr>
                <td colspan="8">
                    {% set onQueue = criteria.queue is null ? '' : ' on the queue ' ~ criteria.queue %}
                    {% if criteria.status is null %}
                        No jobs found{{ onQueue }}.
                    {% else %}
                        No {{ criteria.status | formatJobStatus | lower }} jobs found{{ onQueue }}.
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </table>
    </div>
{% endblock %}
