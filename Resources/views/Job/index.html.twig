{% set page = {
    title: 'Jobs',
    description: 'Resque WebUI jobs'
} %}

{% extends '@AndarisResqueWebUi/layout.html.twig' %}

{% macro sortableHeader(label, field, criteria, parameters) %}
    <th>
        <a href="{{ path('andaris_resque_web_ui_jobs', parameters|merge({'sort': field, 'direction': criteria.getToggledDirection(field)})) }}">
            {{ label }}{% if criteria.isSortedBy(field) %} <span class="caret{{ criteria.descending ? '' : ' caret-up' }}"></span>{% endif %}
        </a>
    </th>
{% endmacro %}

{% block content %}
    {% import _self as helper %}

    {# the filter keeps the ordering, the ordering keeps the filter #}
    {% set order = {'sort': criteria.field, 'direction': criteria.direction} %}
    {% set filter = criteria.status is null ? {} : {'status': criteria.status} %}

    <div class="col-lg-12">
        <h1>Jobs</h1>

        <ul class="nav nav-pills job-status-filter">
            <li class="{{ criteria.status is null ? 'active' }}">
                <a href="{{ path('andaris_resque_web_ui_jobs', order) }}">
                    All <span class="badge">{{ total }}</span>
                </a>
            </li>
            {% for status, count in counts %}
            <li class="{{ criteria.status == status ? 'active' }}">
                <a href="{{ path('andaris_resque_web_ui_jobs', order|merge({'status': status})) }}">
                    {{ status | formatJobStatus }} <span class="badge">{{ count }}</span>
                </a>
            </li>
            {% endfor %}
        </ul>

        <table class="table table-striped table-responsive">
            <tr>
                {{ helper.sortableHeader('ID', 'id', criteria, filter) }}
                {{ helper.sortableHeader('Status', 'status', criteria, filter) }}
                {{ helper.sortableHeader('Queue', 'queue', criteria, filter) }}
                {{ helper.sortableHeader('Worker', 'worker', criteria, filter) }}
                {{ helper.sortableHeader('Created', 'created', criteria, filter) }}
                {{ helper.sortableHeader('Started', 'started', criteria, filter) }}
                {{ helper.sortableHeader('Updated', 'updated', criteria, filter) }}
                {{ helper.sortableHeader('Finished', 'finished', criteria, filter) }}
            </tr>
            {% for job in jobs %}
            <tr>
                <td class="job-id"><a href="{{ path('andaris_resque_web_ui_job', {'jobId': job.id}) }}">{{ job.id }}</a></td>
                <td>{{ job.status | formatJobStatus }}</td>
                <td>{{ job.queue }}</td>
                <td>{{ job.worker }}</td>
                <td class="date-time">{{ job.created | formatTime }}</td>
                <td class="date-time">{{ job.started | formatTime }}</td>
                <td class="date-time">{{ job.updated | formatTime }}</td>
                <td class="date-time">{{ job.finished | formatTime }}</td>
            </tr>
            {% else %}
            <tr>
                <td colspan="8">
                    {% if criteria.status is null %}
                        No jobs found.
                    {% else %}
                        No {{ criteria.status | formatJobStatus | lower }} jobs found.
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </table>
    </div>
{% endblock %}
