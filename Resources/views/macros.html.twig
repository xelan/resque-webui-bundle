{#
    Internal: the column headers of the lists of the bundle are rendered here.
    The attributes are written out unescaped, so they take fixed markup only.
#}
{% macro sortableHeader(label, field, criteria, route, parameters, attributes) %}
    <th{{ attributes is defined and attributes ? ' ' ~ attributes|raw : '' }}>
        <a href="{{ path(route, (parameters|default({}))|merge({'sort': field, 'direction': criteria.getToggledDirection(field)})) }}">
            {{ label }}{% if criteria.isSortedBy(field) %} <span class="caret{{ criteria.descending ? '' : ' caret-up' }}"></span>{% endif %}
        </a>
    </th>
{% endmacro %}
