{% set page = {
    title: 'Workers',
    description: 'Resque WebUI workers'
} %}

{% extends '@AndarisResqueWebUi/layout.html.twig' %}

{% block content %}
    {% import '@AndarisResqueWebUi/macros.html.twig' as helper %}

    <div class="col-lg-12">
        <h1>Workers</h1>

        <table class="table table-striped table-responsive">
            <tr>
                {{ helper.sortableHeader('ID', 'id', criteria, 'andaris_resque_web_ui_workers') }}
                {{ helper.sortableHeader('Status', 'status', criteria, 'andaris_resque_web_ui_workers') }}
                {{ helper.sortableHeader('Running for', 'started', criteria, 'andaris_resque_web_ui_workers') }}
                {{ helper.sortableHeader('Running job', 'job', criteria, 'andaris_resque_web_ui_workers') }}
                {{ helper.sortableHeader('P', 'processed', criteria, 'andaris_resque_web_ui_workers', {}, 'title="Processed" style="width: 4em"') }}
                {{ helper.sortableHeader('C', 'cancelled', criteria, 'andaris_resque_web_ui_workers', {}, 'title="Cancelled" style="width: 4em"') }}
                {{ helper.sortableHeader('F', 'failed', criteria, 'andaris_resque_web_ui_workers', {}, 'title="Failed" style="width: 4em"') }}
                {{ helper.sortableHeader('Interval', 'interval', criteria, 'andaris_resque_web_ui_workers') }}
                {{ helper.sortableHeader('Timeout', 'timeout', criteria, 'andaris_resque_web_ui_workers') }}
                {{ helper.sortableHeader('Memory (limit)', 'memory', criteria, 'andaris_resque_web_ui_workers') }}
            </tr>
            {% for worker in workers %}
            <tr>
                <td>{{ worker.id }}</td>
                <td>{{ worker.status | formatWorkerStatus }}</td>
                <td>{{ worker.started | formatHumanTimeDiff }}</td>
                {% if worker.currentJobId %}
                    <td>
                        <a href="{{ path('andaris_resque_web_ui_job', {'jobId': worker.currentJobId}) }}">{{ worker.currentJobId }}</a> for
                        {{ worker.currentJobStarted | formatHumanTimeDiff }}
                    </td>
                {% else %}
                    <td>-</td>
                {% endif %}

                <td>{{ worker.jobsProcessed }}</td>
                <td>{{ worker.jobsCancelled }}</td>
                <td>{{ worker.jobsFailed }}</td>
                <td>{{ worker.interval }}</td>
                <td>{{ worker.timeout }}</td>
                <td>{{ worker.memory | formatBytes }} ({{ worker.memoryLimit }} MB)</td>
            </tr>
            {% else %}
            <tr>
                <td colspan="10">No running workers found.</td>
            </tr>
            {% endfor %}
        </table>
    </div>
{% endblock %}
