{% set page = {
    title: 'Queues',
    description: 'Resque WebUI queues'
} %}

{% extends '@AndarisResqueWebUi/layout.html.twig' %}

{% block content %}
    {% import '@AndarisResqueWebUi/macros.html.twig' as helper %}

    <div class="col-lg-12">
        <h1>Queues</h1>

        <table class="table table-striped table-responsive">
            <tr>
                {{ helper.sortableHeader('Name', 'name', criteria, 'andaris_resque_web_ui_queues') }}
                {{ helper.sortableHeader('Queued', 'queued', criteria, 'andaris_resque_web_ui_queues', {}, 'class="numeric"') }}
                {{ helper.sortableHeader('Delayed', 'delayed', criteria, 'andaris_resque_web_ui_queues', {}, 'class="numeric"') }}
                {{ helper.sortableHeader('Processed', 'processed', criteria, 'andaris_resque_web_ui_queues', {}, 'class="numeric"') }}
                {{ helper.sortableHeader('Cancelled', 'cancelled', criteria, 'andaris_resque_web_ui_queues', {}, 'class="numeric"') }}
                {{ helper.sortableHeader('Failed', 'failed', criteria, 'andaris_resque_web_ui_queues', {}, 'class="numeric"') }}
                {{ helper.sortableHeader('Total', 'total', criteria, 'andaris_resque_web_ui_queues', {}, 'class="numeric"') }}
            </tr>
            {% for queue in queues %}
            <tr>
                <td>{{ queue.name }}</td>
                <td class="numeric">{{ queue.jobsQueued }}</td>
                <td class="numeric">{{ queue.jobsDelayed }}</td>
                <td class="numeric">{{ queue.jobsProcessed }}</td>
                <td class="numeric">{{ queue.jobsCancelled }}</td>
                <td class="numeric">{{ queue.jobsFailed }}</td>
                <td class="numeric">{{ queue.jobsTotal }}</td>
            </tr>
            {% else %}
            <tr>
                <td colspan="7">No queues found.</td>
            </tr>
            {% endfor %}
        </table>
    </div>
{% endblock %}
